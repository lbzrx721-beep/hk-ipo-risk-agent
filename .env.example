# PostgreSQL + pgvector正式向量库。密码如包含特殊字符，请进行URL编码。
IPO_RISK_POSTGRES_DSN=postgresql://appuser:replace-me@localhost:5432/ragdb

# LangSmith：填入独立的 LangSmith 密钥后，将 false 改为 true，再重启后端。
# 开启会上传提示词、模型回答和检索原文；未公开材料请保持关闭。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hk-ipo-risk-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 多工作区账号必要时填写对应 Workspace ID。
# LANGSMITH_WORKSPACE_ID=
# 仅排查耗时、不想上传输入输出时可同时开启下面两项。
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
